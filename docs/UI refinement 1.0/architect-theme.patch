@@ -0,0 +1,160 @@
+/* Architect theme layer. Loaded after workspace.css; delete the import in main.jsx to revert.
+   Markup is untouched. Screen only, so the A4 briefing print rules in workspace.css still apply. */
+@media screen {
+  :root {
+    --ink:#343a40; --muted:#5f6a75; --accent:#3f6ad8; --accent-dark:#3057bc;
+    --canvas:#f1f4f6; --line:#e5e9ef; --soft:#e8eefb; --danger:#c11f46;
+    --nav:#132742; --radius:6px;
+    --shadow:0 5px 24px #04091408,0 2px 5px #04091409;
+    --crimson:#d92550;
+    font-family:'Open Sans','Segoe UI',Arial,sans-serif;
+  }
+  body { background:var(--canvas); }
+  a,summary,.link-button { color:var(--accent-dark); }
+  ::selection { color:#14275a; background:#cfdcfb; }
+
+  /* ---- controls ---- */
+  button,.button { border-radius:5px; border-color:#d3dbe8; color:#343a40; font-weight:600; }
+  button:hover:not(:disabled),.button:hover { background:#edf2fc; border-color:#aabce5; }
+  .primary { background:var(--accent); border-color:var(--accent); color:#fff; }
+  .primary:hover:not(:disabled) { background:var(--accent-dark); border-color:var(--accent-dark); color:#fff; }
+  input,textarea,select { border-color:#d3dbe8; border-radius:5px; }
+  button:focus-visible,a:focus-visible,summary:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,[role=tabpanel]:focus-visible { outline-color:#316cdd; }
+
+  /* ---- navy rail, Architect wayfinding ---- */
+  .workspace-rail { background:linear-gradient(180deg,#16305a 0%,#102340 55%,#0d1c34 100%); }
+  .brand-mark { background:var(--accent); border-color:transparent; border-radius:6px; }
+  .rail-context { font-size:11px; font-weight:700; letter-spacing:.09em; text-transform:uppercase; color:#8fb4ff; }
+  .app-nav a { font-weight:600; border-radius:6px; color:#d4e0f4; }
+  .app-nav a:hover { background:#ffffff14; }
+  .app-nav a.active { background:var(--accent); box-shadow:0 4px 12px rgb(63 106 216 / 38%); }
+  .rail-help { border-top-color:#ffffff1f; }
+  .header-utilities a:hover { background:#ffffff14; }
+  .app-header { box-shadow:0 1px 3px #04091409; border-bottom:0; }
+  .workspace-location>span { font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:#6c7a8a; }
+  .month-control select { background:#f6f8fb; border-color:#d3dbe8; }
+
+  /* ---- type ---- */
+  h1 { font-weight:600; letter-spacing:-.6px; }
+  h2 { font-size:14px; font-weight:700; letter-spacing:.03em; text-transform:uppercase; }
+  .briefing-sheet h2,.context-card h2,.prediction-stats h2 { text-transform:none; letter-spacing:-.15px; }
+  .muted { color:var(--muted); }
+
+  /* ---- panels ---- */
+  .panel,.context-card { border-color:#eef0f3; border-radius:6px; box-shadow:var(--shadow); }
+  .case-content details>.panel { box-shadow:none; border:0; }
+  .scope-note { border-color:#cfdcf7; background:#e8eefb; color:#2f4d8f; border-radius:5px; }
+
+  /* ---- gradient KPI tiles ---- */
+  .stats { gap:20px; border:0; background:transparent; box-shadow:none; border-radius:0; margin-bottom:22px; }
+  .stat { position:relative; overflow:hidden; color:#fff; border-radius:6px; padding:21px 24px; box-shadow:var(--shadow); }
+  .stat+.stat { border-left:0; }
+  .stat::after { content:''; position:absolute; right:-32px; top:-46px; width:125px; height:125px; border:1px solid #ffffff22; border-radius:50%; pointer-events:none; }
+  .stat:nth-child(1) { background:linear-gradient(135deg,#3c4a7d,#262b4f); }
+  .stat:nth-child(2) { background:linear-gradient(100deg,#b41c40,#d92550); }
+  .stat:nth-child(3) { background:linear-gradient(100deg,#087e9f,#167bb9); }
+  .stat>span { max-width:none; font-size:13px; }
+  .stat .number,.stat:last-child .number { color:#fff; }
+  .stat small,.stat small.muted { color:#fff; opacity:.92; }
+
+  /* ---- progress, filters, tabs ---- */
+  progress { height:8px; border-radius:4px; background:#dde5f3; }
+  progress::-webkit-progress-bar { background:#dde5f3; }
+  progress::-webkit-progress-value { background:var(--accent); }
+  .filters { background:#f4f6fa; border-color:#e5e9ef; border-radius:6px; }
+  .filters button[aria-pressed=true] { color:var(--accent-dark); border-color:#d6e0f5; }
+  .perspective-tabs { border-bottom:1px solid var(--line); padding-bottom:0; gap:22px; }
+  .perspective-tabs button { border:0; border-bottom:3px solid transparent; border-radius:0; background:transparent; padding:10px 2px; margin-bottom:-1px; min-height:44px; }
+  .perspective-tabs button:hover:not(:disabled) { background:transparent; color:var(--accent-dark); }
+  .perspective-tabs button[aria-selected=true] { color:var(--accent-dark); background:transparent; border-bottom-color:var(--accent); }
+  .case-action-tabs { background:#dfe8fa; border-radius:6px; }
+  .case-action-tabs button[aria-selected=true] { color:var(--accent-dark); }
+
+  /* ---- tables ---- */
+  th { background:#f8f9fb; color:#5f6a75; font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; border-top:1px solid var(--line); }
+  td { border-bottom-color:#edf0f5; }
+  tbody tr:hover { background:#fafbfe; }
+  .customer-name { color:#2b3a55; }
+
+  /* ---- badges and status ---- */
+  .badge { font-size:11px; font-weight:700; border-radius:4px; color:#3057bc; background:#e8eefb; }
+  .flagged { color:#ad173d; background:#fce8ed; }
+  .risk { color:var(--danger); }
+  .status-open { color:#3057bc; background:#e8eefb; }
+  .status-deferred,.status-planned,.overdue { color:#855500; background:#fff4d6; }
+  .status-closed,.status-delivered { color:#17653d; background:#e3f6ec; }
+  .connection-state { background:#e3f6ec; color:#17653d; }
+  .connection-state.preview { background:#fff4d6; color:#855500; }
+
+  /* ---- forms ---- */
+  .review-form label,.case-filters label { color:#495057; }
+  .review-form h2 { color:var(--accent-dark); }
+  .success { color:#19643b; background:#e3f6ec; border-color:#b2e3c9; }
+  .error { color:#9b1235; background:#fce8ed; border-color:#f5b8c6; }
+  .technical { background:#f6f8fb; }
+  details { border-top-color:#e9edf3; }
+
+  /* ---- charts (inline SVG fills are overridden here) ---- */
+  .chart text { font-family:'Open Sans','Segoe UI',Arial,sans-serif; font-size:11px; fill:#5f6a75; }
+  .chart .grid { stroke:#e9edf3; }
+  .chart rect { rx:3px; }
+  .chart rect[fill="#356bd9"] { fill:#3f6ad8; }
+  .chart rect[fill="#c6d5ed"] { fill:#a9bdee; }
+  .legend { gap:8px 20px; }
+  .legend span::before { background:#a9bdee; }
+  .legend span.key-recent::before { background:#3f6ad8; }
+  .legend span.key-average::before,.legend span.key-attrition::before { width:20px; height:0; border-top:2px dotted #3c4a7d; border-radius:0; background:none; vertical-align:middle; }
+  .legend span.key-attrition::before { border-top:2px dashed #d92550; }
+  .chart .baseline { stroke:#3c4a7d; stroke-width:1.75; stroke-dasharray:1 5; stroke-linecap:round; }
+  .chart .reference-line { stroke:#d92550; stroke-width:1.5; stroke-dasharray:7 4; }
+  .chart text.line-label { font-size:11px; font-weight:700; }
+  .chart text.line-value { font-size:11px; font-weight:600; }
+  .chart text.average { fill:#3c4a7d; }
+  .chart text.attrition { fill:#c11f46; }
+  .chart .col .hit { cursor:default; }
+  .chart .col.is-active rect { filter:brightness(.9); }
+  .chart-tooltip { z-index:3; display:flex; flex-direction:column; gap:2px; padding:9px 12px; border-radius:6px; color:#fff; background:#262b4f; box-shadow:0 8px 22px rgb(9 25 48 / 28%); font-size:12px; line-height:1.45; white-space:nowrap; }
+  .chart-tooltip strong { font-size:12px; }
+  .chart-tooltip span { opacity:.92; }
+  .chart-reference-note { margin:12px 0; padding:11px 14px; border-left:3px solid #d92550; border-radius:0 5px 5px 0; background:#f8f9fb; font-size:12.5px; line-height:1.65; color:var(--ink); }
+
+  /* ---- case follow-up ---- */
+  .case-summary { background:#e8eefb; border-color:#d3def6; border-radius:6px; }
+  .context-card.original-context { color:#fff; border:0; background:linear-gradient(135deg,#3c4a7d,#262b4f); }
+  .original-context :is(h2,h3,strong,dt,dd,p,.number,.comparison-date,.muted,.eyebrow,small) { color:#fff; }
+  .original-context .muted,.original-context small { opacity:.9; }
+  .original-context .button { color:#fff; background:#ffffff16; border-color:#ffffff4d; }
+  .original-context .button:hover { background:#ffffff26; }
+  .timeline { border-left:2px solid #e0e7f5; }
+  .timeline li::before { background:var(--accent); border:2px solid #fff; box-sizing:content-box; left:-24px; }
+  .workflow-steps li[aria-current=step] { color:var(--accent-dark); border-color:var(--accent); }
+}
+@media screen and (max-width:760px) {
+  .stat .number,.stat:last-child .number { font-size:27px; }
+  .stat { padding:16px 18px; }
+  .perspective-tabs { gap:14px; }
+}
+
+/* ---- Financial context cards (Overview) ---- */
+@media screen {
+  .finance-context { margin:0 0 22px; }
+  .finance-context .section-heading { margin-bottom:12px; }
+  .finance-context .section-heading .muted { margin:2px 0 0; }
+  .finance-cards { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; }
+  .finance-card { display:flex; flex-direction:column; gap:6px; min-width:0; padding:18px 20px 16px; background:#fff; border:1px solid #eef0f3; border-top:3px solid var(--accent); border-radius:6px; box-shadow:var(--shadow); }
+  .finance-card.estimate { border-top-color:#087e9f; }
+  .finance-card-top { display:flex; align-items:center; justify-content:space-between; gap:8px; }
+  .finance-icon { display:grid; place-items:center; width:36px; height:36px; border-radius:50%; color:var(--accent-dark); background:var(--soft); }
+  .finance-card.estimate .finance-icon { color:#087e9f; background:#e3f3f8; }
+  .finance-icon .icon { width:19px; height:19px; }
+  .finance-kind { font-size:11px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:#5f6a75; }
+  .finance-card h3 { margin:8px 0 0; font-size:13px; font-weight:600; color:var(--muted); }
+  .finance-value { font-size:24px; font-weight:650; letter-spacing:-.5px; line-height:1.3; overflow-wrap:anywhere; }
+  .finance-coverage { margin-top:auto; padding-top:10px; display:flex; flex-direction:column; gap:6px; }
+  .coverage-track { display:block; height:5px; border-radius:3px; background:#e5e9ef; overflow:hidden; }
+  .coverage-track i { display:block; height:100%; background:var(--accent); border-radius:3px; }
+  .finance-card.estimate .coverage-track i { background:#087e9f; }
+  .finance-note { margin:12px 0 0; font-size:12px; }
+}
+@media screen and (max-width:1250px) { .finance-cards { grid-template-columns:repeat(2,minmax(0,1fr)); } }
+@media screen and (max-width:760px) { .finance-cards { grid-template-columns:1fr; gap:12px; } .finance-card { padding:16px 18px; } }
